# =============================================================================
# .env.example — Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git — it contains secrets!
# =============================================================================

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Get this from: Atlas Dashboard → Connect → Drivers → Copy connection string
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/

# Database name (default is person_finder — change if you want)
DB_NAME=person_finder

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Use a long random string.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars

# How long tokens stay valid (in minutes). 60 = 1 hour
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Ports ────────────────────────────────────────────────────────────────────
# Change these if port 3000 or 8000 are already in use on your machine
FRONTEND_PORT=3000
BACKEND_PORT=8000
